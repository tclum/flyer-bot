{
  "orgName": "PACE",
  "orgDescription": "Pacific Asian Center for Entrepreneurship (PACE) at UH Mānoa's Shidler College of Business. PACE supports student entrepreneurship through pitch competitions, workshops, and founder events across the islands.",
  "brandVoice": {
    "tone": "energetic, student-focused, Hawaii-local without being corny",
    "do": [
      "use active voice",
      "mention PACE or Shidler when it adds credibility",
      "keep headlines under 8 words",
      "lean into student-founder language"
    ],
    "dont": [
      "don't use emoji in headlines",
      "don't sound corporate or stiff",
      "don't invent taglines — use only the approved list"
    ],
    "taglines": [
      "Build. Pitch. Launch.",
      "Student entrepreneurship starts here.",
      "From idea to island impact."
    ]
  },
